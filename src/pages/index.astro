---
import Layout from "../layouts/Layout.astro";
import categories from "../data/categories.json";
import books from "../data/books.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// 每個類別底下實際有幾本書，顯示在卡片上
const bookCountByCategory = new Map<string, number>();
for (const b of books as any[]) {
  bookCountByCategory.set(b.categoryId, (bookCountByCategory.get(b.categoryId) || 0) + 1);
}
---

<Layout title="三國文獻庫">
  <div class="page">
    <header class="site-header">
      <h1 class="site-title">三國文獻庫</h1>
      <p class="site-subtitle">三國人物誌的姊妹站，收錄原始文獻全文，供讀者查證史料出處</p>
    </header>

    <section class="portal-grid">
      {
        (categories as any[]).map((c) => (
          <a class="portal-card" href={`${base}category/${c.id}`}>
            <img class="portal-card-img" src={`${base}images/categories/${c.id}.jpg`} alt="" loading="lazy" />
            <span class="portal-card-overlay" aria-hidden="true" />
            <span class="portal-card-body">
              <span class="portal-card-title">{c.label}</span>
              <span class="portal-card-desc">{c.description}</span>
              <span class="portal-count">{bookCountByCategory.get(c.id) || 0} 部文獻</span>
            </span>
          </a>
        ))
      }
    </section>
  </div>
</Layout>