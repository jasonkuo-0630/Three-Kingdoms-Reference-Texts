---
import "../styles/style.css";
import categories from "../data/categories.json";
import books from "../data/books.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// 每個類別底下實際有幾本書，顯示在卡片上
const bookCountByCategory = new Map<string, number>();
for (const b of books as any[]) {
  bookCountByCategory.set(b.categoryId, (bookCountByCategory.get(b.categoryId) || 0) + 1);
}
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>三國文獻庫</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600;700;900&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <h1 class="site-title">三國文獻庫</h1>
        <p class="site-subtitle">三國人物誌的姊妹站，收錄原始文獻全文，供讀者查證史料出處</p>
      </header>

      <section class="portal-grid">
        {
          (categories as any[]).map((c) => (
            <a class="portal-card" href={`${base}category/${c.id}`}>
              <h2 class="portal-card-title">{c.label}</h2>
              <p class="portal-card-desc">{c.description}</p>
              <p class="portal-count">{bookCountByCategory.get(c.id) || 0} 部文獻</p>
            </a>
          ))
        }
      </section>
    </div>
  </body>
</html>
