---
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import books from "../../../data/books.json";

export function getStaticPaths() {
  return (books as any[]).map((b) => ({ params: { bookId: b.id } }));
}

const { bookId } = Astro.params;
const book = (books as any[]).find((b) => b.id === bookId)!;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const unitsModules = import.meta.glob<{ default: any }>("../../../data/units/*/*.json", { eager: true });
const units = Object.entries(unitsModules)
  .filter(([path]) => path.includes(`/units/${bookId}/`))
  .map(([path, m]) => {
    const slug = path.split("/").pop()!.replace(/\.json$/, "");
    return { ...m.default, slug };
  })
  .sort((a, b) => a.unitNumber - b.unitNumber);
---

<Layout title={`${book.title} - 三國文獻庫`}>
  <TopBar crumbLabel={book.title} backHref={`${base}category/${book.categoryId}`} backLabel="← 回類別列表" />

  <section class="faction-banner">
    <div class="banner-copy">
      <h1>{book.title}</h1>
      <p>{book.author ? `${book.author}　撰　・　` : ""}{book.description}</p>
    </div>
    <span class="banner-count">{units.length > 0 ? `已收錄 ${units.length} ${book.unitLabelSuffix || book.unitLabelPrefix}` : "尚無收錄內容"}</span>
  </section>

  <main class="slip-panel" aria-label="卷回列表">
    <div class="slip-list">
      {
        units.map((u) => (
          <a class="slip" href={`${base}book/${bookId}/${u.slug}`} aria-label={`查看${u.unitLabel}`}>
            <span class="slip-accent" aria-hidden="true" />
            <span class="slip-mark" aria-hidden="true">{book.unitLabelPrefix}{u.unitNumber}</span>
            <span class="slip-main">
              <span class="slip-name">{u.unitLabel}</span>
              <span class="slip-courtesy">{u.title}</span>
            </span>
            <span class="slip-extra">
              <span class="slip-tags">
                <span class={`slip-tag ${u.status === "complete" ? "slip-tag--hist" : "slip-tag--romance"}`}>
                  {u.status === "complete" ? "全文收錄" : "節選"}
                </span>
              </span>
              <span class="slip-enter">›</span>
            </span>
          </a>
        ))
      }
    </div>
    {units.length === 0 && <p class="empty-state">這本書目前還沒有收錄任何卷／回。</p>}
  </main>
</Layout>