---
import "../../styles/style.css";
import categories from "../../data/categories.json";
import books from "../../data/books.json";

export function getStaticPaths() {
  return (categories as any[]).map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const category = (categories as any[]).find((c) => c.id === id)!;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const booksInCategory = (books as any[]).filter((b) => b.categoryId === id);

// 算出每本書目前實際收錄了幾卷/回（用來顯示在竹簡上，讓讀者知道
// 這本書內容完不完整）
const unitsModules = import.meta.glob<{ default: any }>("../../data/units/*/*.json", { eager: true });
const allUnits = Object.values(unitsModules).map((m) => m.default);
const unitCountByBook = new Map<string, number>();
for (const u of allUnits) {
  unitCountByBook.set(u.bookId, (unitCountByBook.get(u.bookId) || 0) + 1);
}
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{category.label} - 三國文獻庫</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600;700;900&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={base} aria-label="回到三國文獻庫首頁">
          <span class="brand-seal brand-seal--ref" aria-hidden="true">典</span>
          <span class="brand-copy">
            <strong>三國文獻庫</strong>
            <small>返回首頁・{category.label}</small>
          </span>
        </a>
        <a class="top-link" href={base}>← 回首頁</a>
      </div>
    </header>

    <section class="faction-banner">
      <div class="banner-copy">
        <h1>{category.label}</h1>
        <p>{category.description}</p>
      </div>
      <span class="banner-count">{booksInCategory.length > 0 ? `${booksInCategory.length} 部文獻` : "尚無收錄文獻"}</span>
    </section>

    <main class="slip-panel" aria-label="文獻列表">
      <div class="slip-list">
        {
          booksInCategory.map((b) => {
            const count = unitCountByBook.get(b.id) || 0;
            return (
              <a class="slip" href={`${base}book/${b.id}`} aria-label={`查看《${b.title}》`}>
                <span class="slip-accent" aria-hidden="true" />
                <span class="slip-mark" aria-hidden="true">{b.title.slice(0, 1)}</span>
                <span class="slip-main">
                  <span class="slip-name">{b.title}</span>
                  <span class="slip-courtesy">{b.author ? `${b.author}　撰` : "作者未詳"}</span>
                </span>
                <span class="slip-extra">
                  <span class="slip-tags">
                    <span class="slip-tag slip-tag--hist">{count > 0 ? `已收錄 ${count} ${b.unitLabelSuffix || b.unitLabelPrefix}` : "尚未收錄"}</span>
                  </span>
                  <span class="slip-enter">›</span>
                </span>
              </a>
            );
          })
        }
      </div>
      {booksInCategory.length === 0 && <p class="empty-state">這個類別底下還沒有收錄任何文獻。</p>}
    </main>
  </body>
</html>